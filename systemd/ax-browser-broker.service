[Unit]
Description=OpenBrowser Broker API
After=network.target browser-pool-supervisor.service authenticated-chrome.service
Wants=browser-pool-supervisor.service

[Service]
Type=simple
WorkingDirectory=/opt/openbrowser-broker
ExecStart=/opt/openbrowser-broker/bin/ax-browser-broker
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
UMask=077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
