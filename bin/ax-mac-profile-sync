#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -f /etc/default/openbrowser ]]; then
  set -a
  # shellcheck source=/dev/null
  source /etc/default/openbrowser
  set +a
fi
export PYTHONPATH="${ROOT_DIR}:${PYTHONPATH:-}"
export OPENBROWSER_BROKER_ROOT="${OPENBROWSER_BROKER_ROOT:-$ROOT_DIR}"
exec python3 -m ax_browser_broker.mac_tunnel "$@"
