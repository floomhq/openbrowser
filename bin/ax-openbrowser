#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
if [[ -f /etc/default/openbrowser ]]; then
  set -a
  # shellcheck source=/dev/null
  source /etc/default/openbrowser
  set +a
fi
export OPENBROWSER_BROKER_ROOT="${OPENBROWSER_BROKER_ROOT:-$ROOT_DIR}"
export OPENBROWSER_CLI="${OPENBROWSER_CLI:-openbrowser}"
exec python3 -m ax_browser_broker.adapters openbrowser "$@"
