#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
export OPENBROWSER_BROKER_ROOT="${OPENBROWSER_BROKER_ROOT:-$ROOT_DIR}"
export OPENBROWSER_CLI="${OPENBROWSER_CLI:-openbrowser}"
exec python3 -m ax_browser_broker.adapters openbrowser "$@"
